# Copy to .env.local for local development. VITE_* values are public: they end up in the bundle,
# so a secret never goes here.

# Base URL of the API. Relative by default; in development Vite proxies /api to VITE_DEV_API_TARGET.
VITE_API_BASE_URL=/api/v1

# Where the Vite dev server proxies /api (development only).
VITE_DEV_API_TARGET=http://localhost:8000

# Start MSW and the Telegram mock environment, no backend needed (development only).
# Pick a scenario with ?mock=ok|new|banned|error in the URL.
VITE_ENABLE_MOCKS=false

# Output of scripts/dev_gen_init_data.py. It expires after 300 seconds, generate it again.
VITE_DEV_INIT_DATA=
