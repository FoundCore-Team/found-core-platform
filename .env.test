# Test environment — loaded by tests/conftest.py before any `app.*` import.
# Points at a second database inside the same dev Postgres container (see docker-compose.yaml's `db` service).
APP_CONFIG__RUN__ENV=test
APP_CONFIG__DB__URL=postgresql+asyncpg://postgres_user:postgres_password@localhost:5432/found_core_test_db
APP_CONFIG__DB__ECHO=0

# Matches the Redis port published by docker-compose and the Redis service in CI.
# DB 1 (not the default 0) so the tests, which flush it, never wipe the dev cache.
APP_CONFIG__REDIS__URL=redis://localhost:6379/1

# Celery broker for the tests: DB 3, never DB 0 (dev cache), DB 1 (test cache, flushed by the fixtures) or DB 2 (dev broker).
APP_CONFIG__WORKER__BROKER_URL=redis://localhost:6379/3
APP_CONFIG__EMBEDDING__PROVIDER=stub
# The tests never create a real PostHog client; the ones that check events give Container a FakeAnalyticsTracker.
APP_CONFIG__ANALYTICS__PROVIDER=disabled

APP_CONFIG__BOT__TOKEN=123

APP_CONFIG__AUTH__SECRET_KEY=dev-only-insecure-secret-change-me
APP_CONFIG__AUTH__ALGORITHM=HS256
APP_CONFIG__AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_CONFIG__AUTH__INIT_DATA_TTL_SECONDS=300
