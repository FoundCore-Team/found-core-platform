# =========================
# Core
# =========================
APP_CONFIG__DETAILS__TITLE=Found Core API
APP_CONFIG__DETAILS__DESCRIPTION=Backend API for the FoundCore networking Telegram Mini App
# Copy this file to .env — it is a template only and is never read by the app itself.
# dev | test | prod. With prod the app refuses to start if the secret key or bot token below
# is still a placeholder, the secret key is shorter than 32 characters, or RELOAD is true.
APP_CONFIG__RUN__ENV=dev
APP_CONFIG__API__PREFIX=/api
APP_CONFIG__RUN__HOST=0.0.0.0
APP_CONFIG__RUN__PORT=8000
APP_CONFIG__RUN__RELOAD=True

# =========================
# Database (PostgreSQL)
# =========================
APP_CONFIG__DB__URL=postgresql+asyncpg://postgres_user:postgres_password@db:5432/found_core_db
APP_CONFIG__DB__ECHO=0
APP_CONFIG__DB__ECHO_POOL=False
APP_CONFIG__DB__POOL_SIZE=5
APP_CONFIG__DB__MAX_OVERFLOW=10

# Consumed directly by the postgres image in docker-compose.yaml (must match APP_CONFIG__DB__URL above)
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=found_core_db

# =========================
# Redis
# =========================
APP_CONFIG__REDIS__URL=redis://redis:6379/0

# =========================
# Celery worker
# =========================
# Broker for every queue (embeddings, notifications). Same Redis server, but a different logical DB than
# APP_CONFIG__REDIS__URL (DB 0 is the cache). Was APP_CONFIG__EMBEDDING__BROKER_URL before stage 7.
APP_CONFIG__WORKER__BROKER_URL=redis://redis:6379/2

# =========================
# Embeddings
# =========================
# stub: deterministic pseudo-vectors, no API key needed (refused with env=prod). openai: real embeddings.
APP_CONFIG__EMBEDDING__PROVIDER=stub
# Required when PROVIDER=openai.
# APP_CONFIG__EMBEDDING__OPENAI_API_KEY=

# =========================
# Contact notifications
# =========================
# stub: the message text goes to the notification_worker log (refused with env=prod). telegram: sendMessage through
# the Bot API with APP_CONFIG__BOT__TOKEN; needs a real bot and the user to have pressed /start.
APP_CONFIG__NOTIFICATION__PROVIDER=stub
# Frontend URL for the "Open profile" button (`?profile_id=` is appended). Required with env=prod, https only.
# APP_CONFIG__NOTIFICATION__MINI_APP_URL=https://example.com

# =========================
# Rate limits (per user, fixed window)
# =========================
# Every action has built-in defaults; uncomment to change one number (the other keeps its default). Actions:
# contact_open, tag_suggest, tag_create, tag_create_daily, report_create, feed_request, feed_session_build,
# feed_card, feed_card_daily, feed_view, profile_write.
# APP_CONFIG__RATE_LIMIT__CONTACT_OPEN__LIMIT=10
# APP_CONFIG__RATE_LIMIT__CONTACT_OPEN__WINDOW_SECONDS=60

# =========================
# Telegram Bot
# =========================
# Dev/test placeholder — no real bot token yet.
APP_CONFIG__BOT__TOKEN=123

# =========================
# Auth / JWT
# =========================
APP_CONFIG__AUTH__SECRET_KEY=dev-only-insecure-secret-change-me
APP_CONFIG__AUTH__ALGORITHM=HS256
APP_CONFIG__AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=1440
APP_CONFIG__AUTH__INIT_DATA_TTL_SECONDS=300
